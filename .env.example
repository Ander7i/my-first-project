# Токен бота от @BotFather
BOT_TOKEN=123456:AAE...

# ID администраторов через запятую (узнать свой: напишите боту /myid)
ADMIN_IDS=123456789

# ID группы, куда бот публикует вакансии и задания.
# У групп ID отрицательный, например -1001234567890.
# Добавьте бота в группу админом и напишите там /chatid
GROUP_CHAT_ID=-1001234567890

# Контакт для срочных вопросов исполнителей: @ник или ссылка.
# Бот показывает его там, где человеку может понадобиться живой человек —
# например если курьер требует денег. Можно оставить пустым.
SUPPORT_CONTACT=@your_manager

# Файл базы данных
DB_PATH=shopper.db

# Прокси для доступа к api.telegram.org — нужен, только если с вашего
# сервера Telegram недоступен напрямую. Пример: http://user:pass@host:3128
# Если не нужен — оставьте пустым.
PROXY_URL=
