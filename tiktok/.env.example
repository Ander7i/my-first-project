# Ключи приложения: developers.tiktok.com → Manage apps → ваше приложение →
# Credentials. Берите их в том режиме (Sandbox или Production), в котором
# работаете.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Адрес возврата после входа. Ровно такой же должен стоять в настройках
# Login Kit → Desktop → Redirect URI. Обычно менять не нужно.
TIKTOK_REDIRECT_URI=http://localhost:3455/callback/

# Как публиковать:
#   inbox  — в нужное время ролик приходит черновиком во «Входящие» TikTok,
#            вы открываете уведомление и нажимаете «Опубликовать».
#   direct — ролик публикуется сам. Публичные ролики — только после аудита
#            приложения в TikTok, до него видимость только SELF_ONLY.
PUBLISH_MODE=inbox

# Часовой пояс аудитории: в нём показываются пиковые часы и время публикаций.
TIMEZONE=Europe/Moscow

# Пиковые часы вручную, если знаете их точно: TikTok Studio → Аналитика →
# Подписчики → «Активность подписчиков». Через запятую, от лучшего часа к
# худшему, например 19,13. Пусто — посчитать по своей статистике.
PEAK_HOURS=

# За сколько минут до пика публиковать.
LEAD_MINUTES=60

# Не больше стольких роликов в день и не чаще, чем раз в столько часов.
MAX_POSTS_PER_DAY=2
MIN_GAP_HOURS=3

# Как часто снимать статистику, в минутах: от 10 до 120.
COLLECT_EVERY_MINUTES=60

# Файл базы: токены доступа, статистика и очередь.
DB_PATH=tiktok.db
